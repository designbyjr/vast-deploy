# Secure Whisper ASR Service Environment Configuration

# === ASR Model Configuration ===
ASR_ENGINE=faster_whisper
ASR_MODEL=base
ASR_DEVICE=cpu
ASR_QUANTIZATION=int8
SAMPLE_RATE=16000
MODEL_IDLE_TIMEOUT=0

# === Security Configuration ===
TLS_ENABLED=true
TLS_CERT_PATH=/app/certs/cert.pem
TLS_KEY_PATH=/app/certs/key.pem
TLS_AUTO_GENERATE=true
TLS_CERT_DAYS=365

# === Redis Configuration (Upstash) ===
# IMPORTANT: Configure these when setting up Upstash Redis
REDIS_AUTH_ENABLED=true
REDIS_URL=redis://your-upstash-redis-endpoint:port
REDIS_PASSWORD=your-upstash-redis-password
REDIS_TOKEN_DB=0
REDIS_PUBSUB_DB=1
REDIS_MAX_CONNECTIONS=10
REDIS_TIMEOUT=5

# === WebSocket Configuration ===
WEBSOCKET_ENABLED=true
WEBSOCKET_MAX_CONNECTIONS=100
WEBSOCKET_TIMEOUT=300
DEFAULT_WEBSOCKETS=true
WEBSOCKET_PING_INTERVAL=20
WEBSOCKET_PING_TIMEOUT=10

# === Monitoring & Analytics ===
ANALYTICS_ENABLED=true
LOGGING_LEVEL=INFO
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30
LOG_RETENTION_DAYS=7
METRICS_RETENTION_HOURS=24

# === Service Configuration ===
HOST=0.0.0.0
PORT=9443
WORKERS=1
MAX_FILE_SIZE=25MB
CORS_ORIGINS=*
REQUEST_TIMEOUT=300
MAX_REQUEST_SIZE=100MB

# === Development Configuration ===
# Use these for local development with local Redis
DEV_REDIS_PASSWORD=securepassword
DEBUG=false
LOG_SQL=false

# === Security Headers ===
SECURE_HEADERS=true
HSTS_MAX_AGE=31536000
CONTENT_SECURITY_POLICY=default-src 'self'

# === Rate Limiting ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# === File Upload Limits ===
UPLOAD_MAX_SIZE=25MB
UPLOAD_ALLOWED_TYPES=audio/wav,audio/mp3,audio/m4a,audio/flac,audio/ogg