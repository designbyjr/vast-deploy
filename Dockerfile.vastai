# Vast.ai optimized Dockerfile for Secure Whisper ASR Service
# Based on vastai/base-image for better compatibility
FROM vastai/base-image:latest

# Set working directory
WORKDIR /workspace

# Install system dependencies
RUN apt-get update && apt-get install -y \
    --no-install-recommends \
    curl \
    ca-certificates \
    openssl \
    build-essential \
    python3-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY . .

# Create necessary directories
RUN mkdir -p /workspace/certs /workspace/logs /workspace/temp \
    && chmod 755 /workspace/certs /workspace/logs /workspace/temp

# Set environment variables for Vast.ai compatibility
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV TLS_ENABLED=true
ENV TLS_AUTO_GENERATE=true
ENV TLS_CERT_PATH=/workspace/certs/cert.pem
ENV TLS_KEY_PATH=/workspace/certs/key.pem
ENV REDIS_AUTH_ENABLED=false
ENV HOST=0.0.0.0
ENV PORT=9443
ENV JUPYTER_DIR=/workspace
ENV DATA_DIRECTORY=/workspace
ENV OPEN_BUTTON_PORT=9443

# Create entrypoint script for Vast.ai
RUN echo '#!/bin/bash' > /workspace/entrypoint.sh && \
    echo 'echo "🎤 Starting Secure Whisper ASR Service on Vast.ai..."' >> /workspace/entrypoint.sh && \
    echo 'echo "📁 Working directory: $(pwd)"' >> /workspace/entrypoint.sh && \
    echo 'echo "🌐 Service will be available on port: $PORT"' >> /workspace/entrypoint.sh && \
    echo 'echo "🔐 TLS: $TLS_ENABLED"' >> /workspace/entrypoint.sh && \
    echo 'echo "📊 Open button will connect to port: $OPEN_BUTTON_PORT"' >> /workspace/entrypoint.sh && \
    echo 'export OPEN_BUTTON_PORT=9443' >> /workspace/entrypoint.sh && \
    echo 'env | grep _ >> /etc/environment || true' >> /workspace/entrypoint.sh && \
    echo 'python run.py' >> /workspace/entrypoint.sh && \
    chmod +x /workspace/entrypoint.sh

# Default command for Vast.ai
CMD ["/workspace/entrypoint.sh"]